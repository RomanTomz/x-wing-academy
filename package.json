{
  "name": "x-wing-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "description": "A retro arcade space shooter that sneaks in UK Year 2 maths."
}
